@{
    ViewData["Title"] = "Bienvenue - BiblioRabat";
    
}

<div class="container-fluid p-0">
    <div class="row align-items-center justify-content-center min-vh-100 g-0" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
        <div class="col-md-8 text-center px-4">
            <span class="badge bg-primary rounded-pill px-3 py-2 mb-4 shadow-sm animate-fade-in" style="animation-delay: 0.1s;">
                <i class="bi bi-stars me-2"></i>Nouveauté 2026
            </span>

            <h1 class="display-3 fw-bold text-dark mb-4 animate-fade-in" style="animation-delay: 0.3s;">
                Bienvenue sur <span class="text-primary">BiblioCloud</span>
            </h1>

            <p class="lead text-muted mb-5 animate-fade-in" style="animation-delay: 0.5s; max-width: 700px; margin: 0 auto;">
                Découvrez un espace moderne dédié à la lecture et au savoir. 
                Explorez notre vaste collection d'ouvrages et gérez vos emprunts en quelques clics.
            </p>

            <div class="animate-fade-in" style="animation-delay: 0.7s;">
                <a asp-controller="Livres" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow-lg btn-hover-pulse">
                    Accéder à la Bibliothèque <i class="bi bi-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* Animations CSS */
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
        opacity: 0;
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .btn-hover-pulse:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 20px rgba(13, 110, 253, 0.3) !important;
    }
</style>