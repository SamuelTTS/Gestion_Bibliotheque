@model Livres

@{
    ViewData["Title"] = "Ajouter un livre - Admin";
}

<div class="container py-5 animate-fade-in">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <a asp-action="Index" class="btn btn-link text-muted mb-3 p-0 text-decoration-none transition-03">
                <i class="bi bi-arrow-left"></i> Retour au catalogue
            </a>

            <div class="card border-0 shadow-lg" style="border-radius: 25px; overflow: hidden;">
                <div style="height: 6px; background: linear-gradient(90deg, #0d6efd, #38bdf8);"></div>
                
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary-subtle rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px;">
                            <i class="bi bi-book-plus text-primary fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Nouvel Asset</h3>
                        <p class="text-muted small">Enregistrement d'un nouvel ouvrage dans le Cloud</p>
                    </div>

                    <form asp-controller="Livres" asp-action="Create" method="post" class="needs-validation">
                        <div class="mb-4">
                            <label asp-for="Titre" class="form-label fw-bold small text-uppercase tracking-wider">Titre du livre</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-primary"><i class="bi bi-pencil-square"></i></span>
                                <input asp-for="Titre" class="form-control border-light bg-light rounded-end-pill" placeholder="Ex: Maîtriser Docker" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Auteur" class="form-label fw-bold small text-uppercase tracking-wider">Auteur</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-primary"><i class="bi bi-person"></i></span>
                                <input asp-for="Auteur" class="form-control border-light bg-light rounded-end-pill" placeholder="Nom de l'auteur" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="categories" class="form-label fw-bold small text-uppercase tracking-wider">Catégorie</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 text-primary"><i class="bi bi-tags"></i></span>
                                <input asp-for="categories" class="form-control border-light bg-light rounded-end-pill" placeholder="Informatique, Cloud, etc." />
                            </div>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow btn-hover-pulse fw-bold py-3">
                                <i class="bi bi-cloud-upload me-2"></i>Confirmer l'ajout
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4 animate-fade-in" style="animation-delay: 0.4s;">
                <p class="text-muted small">
                    <i class="bi bi-shield-lock me-1"></i> 
                    Action enregistrée dans les logs administrateur.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    /* Animation d'entrée */
    .animate-fade-in {
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Effets Focus */
    .form-control:focus {
        background-color: #fff !important;
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
    
    .input-group-text {
        border-radius: 50rem 0 0 50rem !important;
    }
    
    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .transition-03 {
        transition: all 0.3s ease;
    }

    .btn-hover-pulse:hover {
        transform: scale(1.02);
        box-shadow: 0 8px 20px rgba(13, 110, 253, 0.3) !important;
    }
</style>